#!/bin/bash
#SBATCH --job-name=grpo-sgs-synth
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:4
#SBATCH --time=1-00:00:00
#SBATCH --mem=400G
#SBATCH --array=0-3
#SBATCH --output=files/logs/%x-%A_%a.out

# GRPO (SGS Synth.) baseline: grpo.sbatch trained on the original targets plus the
# distinct synthetic problems generated by the matching 5-iter SGS on-policy GRPO
# run. Build the data first with misc/make_sgs_synth_sorting.py (edit its RUNS path
# and run ids), which writes files/data/sorting_sgs_onpolicy_5iters_synth/.
# One array task per train config (see slurm_scripts/README.md).
#
# Usage (from the repo root):
#   python misc/make_sgs_synth_sorting.py
#   sbatch -A <account> -p <partition> slurm_scripts/train/grpo_sgs_synth.sbatch
# Env overrides and extra args: as in grpo.sbatch.

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-.}"
export DATA_DIR="${DATA_DIR:-files/data/sorting_sgs_onpolicy_5iters_synth}" METHOD="${METHOD:-grpo-sgs-synth}"
exec bash slurm_scripts/train/grpo.sbatch "$@"
